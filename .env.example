# Copy to .env and fill in. Never commit .env.
PORT=8080
NODE_ENV=development

# Supabase (server-side only — the service role key must NEVER be in the Flutter app)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=fingerprints

# Shared key the Flutter app sends in the X-App-Key header
APP_API_KEY=

# Upload limits / rate limiting
MAX_UPLOAD_BYTES=15728640
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=20
